        "from scipy.special import softmax\n",
        "\n",
        "DEFAULT = dict(seed=42, dt=0.004, J=[0.0123,0.0123,0.0224], mass=1.2,\n",
        "    arm=0.225, kf=6.11e-8, km=1.50e-9, Np=15, Nc=10,\n",
        "    Q=[10,10,5,1,1,0.5], R=[0.1,0.1,0.1], torque_limit=0.1,\n",
        "    angle_limit=float(np.deg2rad(65)), rho=1000., alpha0=2.5, beta=0.3,\n",
        "    alpha_min=0.5, alpha_max=10., osqp_tol=1e-4, osqp_max_iter=4000)\n",
        "STATE_NAMES=['phi','theta','psi','p','q','r']\n",
        "SCALE=np.array([np.pi/3,np.pi/3,np.pi,2.,2.,2.])\n",
        "\n",
        "def rhs(x,u,J):\n",
        "    \"\"\"ZYX Euler kinematics + Euler rigid-body dynamics in body coordinates.\"\"\"\n",
        "    phi,theta,psi,p,q,r=x\n",
        "    sp,cp=np.sin(phi),np.cos(phi)\n",
        "    st,ct=np.sin(theta),np.cos(theta)\n",
        "    omega=np.array([p,q,r])\n",
        "    rates=np.array([p+sp*st/ct*q+cp*st/ct*r, cp*q-sp*r, (sp*q+cp*r)/ct])\n",
        "    return np.r_[rates,(u-np.cross(omega,J*omega))/J]\n",
        "\n",
        "def rk4(x,u,dt,J):\n",
        "    k1=rhs(x,u,J); k2=rhs(x+dt*k1/2,u,J)\n",
        "    k3=rhs(x+dt*k2/2,u,J); k4=rhs(x+dt*k3,u,J)\n",
        "    return x+dt*(k1+2*k2+2*k3+k4)/6\n",
        "\n",
        "def linearize(x,u,cfg):\n",
