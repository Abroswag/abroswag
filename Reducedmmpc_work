        "\n",
        "DEFAULT = dict(seed=42, dt=0.004, J=[0.0123,0.0123,0.0224], mass=1.2,\n",
        "    arm=0.225, kf=6.11e-8, km=1.50e-9, Np=15, Nc=10,\n",
        "    Q=[10,10,5,1,1,0.5], R=[0.1,0.1,0.1], torque_limit=0.1,\n",
        "    angle_limit=float(np.deg2rad(65)), rho=1000., alpha0=2.5, beta=0.3,\n",
        "    alpha_min=0.5, alpha_max=10., osqp_tol=1e-4, osqp_max_iter=4000)\n",
        "STATE_NAMES=['phi','theta','psi','p','q','r']\n",
        "SCALE=np.array([np.pi/3,np.pi/3,np.pi,2.,2.,2.])\n",
        "\n",
        "def rhs(x,u,J):\n",
        "    \"\"\"ZYX Euler kinematics + Euler rigid-body dynamics in body coordinates.\"\"\"\n",
        "    phi,theta,psi,p,q,r=x\n",
        "    sp,cp=np.sin(phi),np.cos(phi)\n",
        "    st,ct=np.sin(theta),np.cos(theta)\n",
        "    omega=np.array([p,q,r])\n",
        "    rates=np.array([p+sp*st/ct*q+cp*st/ct*r, cp*q-sp*r, (sp*q+cp*r)/ct])\n",
        "    return np.r_[rates,(u-np.cross(omega,J*omega))/J]\n",
        "\n",
        "def rk4(x,u,dt,J):\n",
        "    k1=rhs(x,u,J); k2=rhs(x+dt*k1/2,u,J)\n",
        "    k3=rhs(x+dt*k2/2,u,J); k4=rhs(x+dt*k3,u,J)\n",
        "    return x+dt*(k1+2*k2+2*k3+k4)/6\n",
        "\n",
        "def linearize(x,u,cfg):\n",
        "    J=np.asarray(cfg['J']); h=1e-25\n",
        "    A=np.column_stack([np.imag(rhs(x.astype(complex)+1j*h*np.eye(6)[j],u,J))/h for j in range(6)])\n",
        "    B=np.column_stack([np.imag(rhs(x,u.astype(complex)+1j*h*np.eye(3)[j],J))/h for j in range(3)])\n",
        "    # Absolute-coordinate affine dynamics, essential at non-equilibrium samples.\n",
        "    c=rhs(x,u,J)-A@x-B@u\n",
        "    aug=np.zeros((10,10)); aug[:6,:6]=A; aug[:6,6:9]=B; aug[:6,9]=c\n",
        "    E=expm(aug*cfg['dt'])\n",
        "    return E[:6,:6],E[:6,6:9],E[:6,9]\n",
        "\n",
        "def angle_error(x,ref):\n",
        "    e=x-ref\n",
        "    e=e.copy(); e[2]=(e[2]+np.pi)%(2*np.pi)-np.pi\n",
        "    return e\n",
        "\n",
        "def reference(t,kind='sinusoid'):\n",
        "    \"\"\"Smooth desired attitude; body-rate target from exact inverse Euler map.\"\"\"\n",
        "    if kind=='sinusoid':\n",
        "        a=np.pi/3; w=np.pi\n",
        "        ang=np.array([a*np.sin(w*t),a*np.sin(w*t+np.pi/4),0.])\n",
        "        d=np.array([a*w*np.cos(w*t),a*w*np.cos(w*t+np.pi/4),0.])\n",
        "    elif kind=='gentle':\n",
        "        a=0.25; w=0.8\n",
        "        ang=np.array([a*np.sin(w*t),a*np.sin(w*t+np.pi/4),0.15*np.sin(.5*t)])\n",
        "        d=np.array([a*w*np.cos(w*t),a*w*np.cos(w*t+np.pi/4),.075*np.cos(.5*t)])\n",
        "    else: raise ValueError(kind)\n",
        "    ph,th,_=ang\n",
        "    E_inv=np.array([[1,0,-np.sin(th)],[0,np.cos(ph),np.sin(ph)*np.cos(th)],\n",
        "                    [0,-np.sin(ph),np.cos(ph)*np.cos(th)]])\n",
        "    return np.r_[ang,E_inv@d]\n",
