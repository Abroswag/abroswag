        "def spiral_reference(t):\n",
        "    w=.2*np.pi\n",
        "    return (np.array([-2.5*np.cos(w*t),2*np.sin(w*t),.5*t+1.5]),\n",
        "            np.array([2.5*w*np.sin(w*t),2*w*np.cos(w*t),.5]),\n",
        "            np.array([2.5*w*w*np.cos(w*t),-2*w*w*np.sin(w*t),0.]))\n",
        "\n",
        "\n",
        "def simulate_spiral(bank,cfg,duration=30.,out='online_output'):\n",
        "    \"\"\"Additional z-up translational demo. Outer PD gains are reconstruction assumptions.\"\"\"\n",
        "    ctl=MultiMPC(bank,cfg,'reduced');dt=cfg['dt'];n=int(duration/dt)\n",
        "    x=np.zeros(6);pos,vel,_=spiral_reference(0);mass=cfg['mass'];J=np.array(cfg['J'])\n",
        "    positions=[];targets=[];attitudes=[];angles_ref=np.zeros(6);thrust=mass*9.81\n",
        "    for k in range(n):\n",
        "        t=k*dt;pd_,vd,ad=spiral_reference(t)\n",
        "        if k%5==0: # outer loop 50 Hz, attitude loop 250 Hz\n",
        "            force=mass*(ad+2.0*(pd_-pos)+2.2*(vd-vel)+np.array([0,0,9.81]))\n",
        "            mag=max(np.linalg.norm(force),1e-9)\n",
        "            ph=np.arcsin(np.clip(-force[1]/mag,-1,1));th=np.arctan2(force[0],force[2])\n",
        "            angles_ref=np.r_[np.clip([ph,th],-np.pi/3,np.pi/3),0.,0.,0.,0.]\n",
        "            thrust=np.clip(mag,0,2.5*mass*9.81)\n",
        "        u,info=ctl.act(x,np.tile(angles_ref,(cfg['Np'],1)))\n",
        "        ph,th,ps=x[:3]\n",
        "        b3=np.array([np.cos(ph)*np.sin(th)*np.cos(ps)+np.sin(ph)*np.sin(ps),\n",
        "            np.cos(ph)*np.sin(th)*np.sin(ps)-np.sin(ph)*np.cos(ps),np.cos(ph)*np.cos(th)])\n",
        "        acc=thrust/mass*b3-np.array([0,0,9.81])\n",
        "        positions.append(pos.copy());targets.append(pd_);attitudes.append(x.copy())\n",
        "        pos=pos+dt*vel+.5*dt**2*acc;vel=vel+dt*acc;x=rk4(x,u,dt,J)\n",
        "        if abs(x[1])>np.deg2rad(80) or not np.isfinite(x).all():raise RuntimeError('Spiral left Euler envelope')\n",
        "    pos=np.array(positions);ref=np.array(targets);rmse=np.sqrt(np.mean((pos-ref)**2,axis=0))\n",
        "    out=Path(out);out.mkdir(exist_ok=True)\n",
        "    np.savez_compressed(out/'spiral.npz',position=pos,reference=ref,attitude=np.array(attitudes),dt=dt)\n",
        "    pd.DataFrame({'axis':['x','y','z'],'rmse_m':rmse}).to_csv(out/'spiral_metrics.csv',index=False)\n",
        "    fig=plt.figure(figsize=(8,6));ax=fig.add_subplot(projection='3d')\n",
        "    ax.plot(*ref.T,'k--',label='Reference');ax.plot(*pos.T,label='Reduced MMPC + assumed outer PD')\n",
        "    ax.set(xlabel='x (m)',ylabel='y (m)',zlabel='z (m)');ax.legend();fig.tight_layout()\n",
        "    fig.savefig(out/'spiral.png',dpi=180);plt.show();return rmse\n"
